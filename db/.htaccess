# ============================================================
# Binary Alive — db/ folder protection
# This folder contains SQLite database and runtime locks.
# No file in here should EVER be accessible from the web.
# Compatible with Apache 2.4 (cPanel EA4 / LiteSpeed) and 2.2.
# ============================================================

Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
