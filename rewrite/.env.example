# Turso Database Configuration
TURSO_URL=libsql://your-db-org.turso.io
TURSO_TOKEN=your-turso-auth-token

# Security & Sessions
SECRET_KEY=change-me-to-a-secure-random-64-character-hex-string
SESSION_TIMEOUT_MINUTES=15
FORCE_HTTPS=true
ALLOWED_IPS=

# Cron Shared Secret (Used by cron.php to authenticate against Node.js internal route)
CRON_SECRET=change-me-to-a-secure-random-token

# Server Port
PORT=3000
NODE_ENV=development
