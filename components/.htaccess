# ============================================================
# Binary Alive — components/ folder protection
# This folder contains header, footer, and navbar partials.
# These are only used internally via require_once.
# No file should be directly accessible from the web.
# Compatible with Apache 2.4 (cPanel EA4 / LiteSpeed) and 2.2.
# ============================================================

Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
