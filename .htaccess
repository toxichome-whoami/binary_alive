# ============================================================
# Binary Alive — Root Security Rules
# ============================================================

# Disable directory listing
Options -Indexes

# -----------------------------------------------
# 1. BLOCK SOURCE CODE LEAKS
#    Block any file that could expose PHP source
# -----------------------------------------------
<FilesMatch "\.(php~|php\.bak|php\.old|php\.orig|php\.save|php\.swp|php\.swo|bak|old|orig|save|swp|swo|tmp)$">
    Order deny,allow
    Deny from all
</FilesMatch>

# Force PHP files to always be processed as PHP (never served as plain text)
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>

# -----------------------------------------------
# 2. BLOCK SENSITIVE DATA FILES
# -----------------------------------------------
<FilesMatch "\.(json|sqlite|db|sqlite3|log|md|sh|env|sql|git|gitattributes|gitignore|htpasswd|key|pem|crt|cert)$">
    Order deny,allow
    Deny from all
</FilesMatch>

# Explicitly block access to configuration file
<Files "config.php">
    Order deny,allow
    Deny from all
</Files>

# Block hidden files (dot files like .gitattributes, .env)
<FilesMatch "^\.">
    Order deny,allow
    Deny from all
</FilesMatch>

# -----------------------------------------------
# 3. FORCE HTTPS (uncomment if SSL is active)
# -----------------------------------------------
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# -----------------------------------------------
# 4. BLOCK BAD BOTS & COMMON ATTACK PATTERNS
# -----------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block requests with suspicious query strings
    RewriteCond %{QUERY_STRING} (eval\(|base64_decode|GLOBALS|_REQUEST) [NC]
    RewriteRule .* - [F,L]

    # Block null bytes
    RewriteCond %{QUERY_STRING} \\0 [NC]
    RewriteRule .* - [F,L]
</IfModule>

# -----------------------------------------------
# 5. SECURITY HEADERS
# -----------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
