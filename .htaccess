# ============================================================
# Binary Alive — Root Security Rules
# Optimized for cPanel (Apache 2.4, LiteSpeed, CloudLinux, EA4)
# ============================================================

# Disable directory listing
Options -Indexes

# -----------------------------------------------
# 1. BLOCK SOURCE CODE LEAKS & TEMP BACKUPS
# -----------------------------------------------
<FilesMatch "\.(php~|php\.bak|php\.old|php\.orig|php\.save|php\.swp|php\.swo|bak|old|orig|save|swp|swo|tmp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Force PHP files to always be processed as PHP
<FilesMatch "\.php$">
    SetHandler application/x-httpd-php
</FilesMatch>

# -----------------------------------------------
# 2. BLOCK SENSITIVE DATA FILES & CONFIGS
# -----------------------------------------------
<FilesMatch "\.(json|sqlite|db|sqlite3|log|md|sh|env|sql|git|gitattributes|gitignore|htpasswd|key|pem|crt|cert)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Explicitly block access to configuration file
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# Block hidden dot-files while preserving cPanel AutoSSL / ACME challenges
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow cPanel AutoSSL and Let's Encrypt domain validation challenges
    RewriteCond %{REQUEST_URI} ^/\.well-known/ [NC]
    RewriteRule .* - [L]

    # Block all other hidden dot-files (.env, .git, etc.)
    RewriteRule (^\.|/\.) - [F,L]

    # Block malicious query strings & null byte injection
    RewriteCond %{QUERY_STRING} (eval\(|base64_decode|GLOBALS|_REQUEST|\\0) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# -----------------------------------------------
# 3. HTTP SECURITY HEADERS
# -----------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
